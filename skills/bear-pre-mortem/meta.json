{
  "id": "bear-pre-mortem",
  "name": "Bear Pre-Mortem",
  "version": "1.2.0",
  "description": "对多头 thesis 做 steelman 空头压力测试，故意单边全力攻击",
  "category": "research",
  "author": "buy-side-research-system",
  "tags": ["risk-management", "thesis-validation", "bear-case", "buy-side", "pre-mortem"],
  
  "trigger": {
    "type": "keyword",
    "keywords": [
      "帮我打这个逻辑",
      "帮我找漏洞",
      "如果我错了",
      "空头压力测试",
      "假设这个 thesis 错了",
      "帮我反向思考",
      "我会不会过于乐观"
    ],
    "description": "当用户要压测或反向思考一个 thesis 时触发"
  },
  
  "capabilities": {
    "generates": "7-section bear case analysis",
    "output_format": "900-1400 字",
    "includes": ["short-pitch", "accounting-flags", "base-rate", "path-of-pain"],
    "emphasis": "fact-driven, no hand-waving",
    "requirements": ["source links required", "base rate examples", "follow CLAUDE.md source policy"],
    "inputs": ["alpha-thesis output", "current conversation thesis", "research-journal notes"]
  },
  
  "workflow": {
    "stage": "validation",
    "prerequisites": ["alpha-thesis or topic research notes"],
    "next_steps": ["research-journal", "next-step"],
    "success_criteria": "看完想做空"
  },
  
  "special_notes": "故意单边——不是平衡讨论风险，而是全力攻击 thesis。压测后 thesis 还站得住，conviction 是真的。",
  
  "required_sections": [
    "smartest_short_seller_pitch",
    "unit_economics_interrogation",
    "accounting_red_flags_structured",
    "what_bull_is_glossing_over",
    "base_rate_historical_comparable",
    "behavioral_bias_self_check",
    "path_of_pain"
  ],
  
  "quality_gates": {
    "anti_patterns": [
      "reads_like_another_perspective",
      "accounting_red_flags_section_too_shallow",
      "no_specific_comparable_cases",
      "lacks_concrete_numbers_and_events",
      "each_bear_point_immediately_rebuffed"
    ],
    "source_requirements": [
      "filing_sources_with_page_numbers",
      "base_rate_cases_with_specific_companies",
      "form4_insider_trading_disclosures",
      "no_hear_say_no_rumors"
    ]
  }
}
