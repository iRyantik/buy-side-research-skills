{
  "id": "research-journal",
  "name": "Research Journal",
  "version": "3.0.0",
  "description": "Journal-first research memory skill for preserving solved research insights and generating high-density Boss Briefs.",
  "category": "research",
  "author": "buy-side-research-system",
  "tags": [
    "research-journal",
    "topic-journal",
    "boss-brief",
    "research-notes",
    "buy-side"
  ],
  "trigger": {
    "type": "keyword",
    "keywords": [
      "总结本轮研究",
      "总结本轮行业研究",
      "总结本轮 topic 研究",
      "写进 journal",
      "research journal",
      "整理这个 topic",
      "做一版给老板看的",
      "boss brief",
      "给 PM 的版本",
      "发给别人看的"
    ],
    "description": "当用户要沉淀研究结果或生成老板版研究 memo 时触发"
  },
  "capabilities": {
    "modes": [
      "Private Research Journal",
      "Boss Brief"
    ],
    "writes": [
      "topics/[topic_type]/[topic-slug]/[YYYY-MM-DD]-[session-slug]/research-journal.md",
      "topics/[topic_type]/[topic-slug]/[YYYY-MM-DD]-[session-slug]/boss-brief.md"
    ],
    "updates": [
      "topics/[topic_type]/[topic-slug]/index.md"
    ],
    "requirements": [
      "preserve solved research insight, not raw reminders",
      "boss brief is high-density, not simplified",
      "follow CLAUDE.md source policy"
    ]
  }
}
