{
  "id": "pair-trade",
  "name": "Pair Trade",
  "version": "3.1.0",
  "description": "Journal-first long/short pair research and monitor for pair validity, spread logic, and hedge candidates.",
  "category": "research",
  "author": "buy-side-research-system",
  "tags": [
    "pair-trade",
    "long-short",
    "spread",
    "market-neutral",
    "hedge-candidate"
  ],
  "trigger": {
    "type": "keyword",
    "keywords": [
      "pair trade",
      "Long X Short Y",
      "Long / Short",
      "做多 做空",
      "这两个能不能 pair",
      "X 用什么对冲",
      "ASML 找 hedge candidate",
      "hedge candidate",
      "spread",
      "pair 还成立吗",
      "review all pairs",
      "review 一下所有 pair",
      "找对冲"
    ],
    "description": "当用户要构建、评估、监控 long/short pair 或寻找 hedge candidate 时触发"
  },
  "capabilities": {
    "modes": [
      "Builder",
      "Monitor"
    ],
    "can_trigger": [
      "next-step",
      "bear-pre-mortem",
      "earnings-setup"
    ],
    "feeds_into": [
      "research-journal"
    ],
    "requirements": [
      "two independent legs",
      "spread mechanism",
      "correlation and beta awareness",
      "borrow and liquidity awareness",
      "source links and as-of timestamps"
    ]
  }
}
