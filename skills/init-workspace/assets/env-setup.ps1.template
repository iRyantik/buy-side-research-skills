# Ingest 环境配置
# 复制本文件为 env-setup.ps1，填入你的信息后运行：  .\env-setup.ps1

# --- 美股 SEC Filing（必填，否则 EdgarTools 不可用）---
# 格式: "Name email@domain.com"
$env:EDGAR_IDENTITY = ""

# --- EdgarTools 数据目录（避免 edgar/ 文件夹散落在当前目录）---
$edgarDir = Join-Path $PSScriptRoot "edgar_data"
New-Item -ItemType Directory -Force -Path $edgarDir | Out-Null
$env:EDGAR_LOCAL_DATA_DIR = $edgarDir

# --- 中国用户 HuggingFace 镜像（可选）---
# $env:HF_ENDPOINT = "https://hf-mirror.com"

# --- describe-figures 视觉模型（可选，Claude 多模态已覆盖）---
# $env:VLM_API_URL = "https://api.openai.com/v1"
# $env:VLM_API_KEY = ""
# $env:VLM_MODEL = "gpt-4o"

# --- 写入用户环境变量（持久化）---
if ($env:EDGAR_IDENTITY) {
    [Environment]::SetEnvironmentVariable("EDGAR_IDENTITY", $env:EDGAR_IDENTITY, "User")
    Write-Host "[OK] EDGAR_IDENTITY 已持久化到用户环境变量"
} else {
    Write-Host "[!] EDGAR_IDENTITY 未设置，美股 SEC 路由不可用"
}
[Environment]::SetEnvironmentVariable("EDGAR_LOCAL_DATA_DIR", $edgarDir, "User")
Write-Host "[OK] Edgar 数据目录: $edgarDir"

Write-Host "环境配置完成。运行 _scripts/bootstrap-ingest-deps.ps1 -CheckOnly 检查状态"
