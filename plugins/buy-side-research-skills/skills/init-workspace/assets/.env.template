# Buy-Side Research Workspace — Provider Environment Variables
# Copy to .env and fill in the providers you need.
# Playwright is not configured here. Browser-backed flows use local Node.js + Playwright
# runtime or host MCP setup, not provider credentials in .env.

# SEC EDGAR（美股）
# 格式: "Name email@domain.com"
# 申请: https://efts.sec.gov/ （填 Name+Email 即生效）
EDGAR_IDENTITY=

# DART（韩股）
# 申请: https://opendart.fss.or.kr/ （免费注册获取 API Key）
# DART_API_KEY=

# EDINET（日股）
# 申请: https://disclosure2.edinet-fsa.go.jp/ （免费注册）
# EDINET_API_KEY=

# FinMind（台股）
# 申请: https://finmindtrade.com/ （免费注册获取 Token）
# FINMIND_TOKEN=

# DeepSeek AI（OpenAI 兼容 API；日报标题翻译 + Email Intelligence review。推荐配置）
# 申请: https://platform.deepseek.com/ （有 key 后填入）
# DEEPSEEK_API_KEY=
# DEEPSEEK_API_BASE=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-v4-flash

# Email Intelligence 保存层目录（可选；不填则使用默认 OneDrive /Email-AI/）
# EMAIL_INTELLIGENCE_BASE=

# Coverage Monitor delivery（可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
COVERAGE_EMAIL_TO=
WECOM_WEBHOOK_URL=
