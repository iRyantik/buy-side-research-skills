# Ingest / Financial Data 环境配置
# 复制本文件为 env-setup.ps1，填入你的信息后运行：
#   Windows:  .\env-setup.ps1
#   macOS:    pwsh ./env-setup.ps1

# --- 美股 SEC Filing（必填，否则 EdgarTools 不可用）---
# 格式: "Name email@domain.com"
$env:EDGAR_IDENTITY = ""

# --- 韩国 DART API Key（financial-data 可选，拉取韩国上市公司财报需要）---
# 免费注册获取: https://opendart.fss.or.kr/
# $env:DART_API_KEY = ""

# --- 日本 EDINET API Key（financial-data 可选，拉取日本上市公司财报需要）---
# 免费注册 / 申请: https://disclosure2.edinet-fsa.go.jp/
# $env:EDINET_API_KEY = ""

# --- EdgarTools 数据目录（避免 edgar/ 文件夹散落在当前目录）---
$edgarDir = Join-Path $PSScriptRoot "edgar_data"
New-Item -ItemType Directory -Force -Path $edgarDir | Out-Null
$env:EDGAR_LOCAL_DATA_DIR = $edgarDir

# --- 中国用户 HuggingFace 镜像（可选）---
# $env:HF_ENDPOINT = "https://hf-mirror.com"

# --- describe-figures 视觉模型（可选，Claude 多模态已覆盖）---
# $env:VLM_API_URL = "https://api.openai.com/v1"
# $env:VLM_API_KEY = ""
# $env:VLM_MODEL = "gpt-4o"

# --- 写入用户环境变量（持久化）---
if ($env:EDGAR_IDENTITY) {
    [Environment]::SetEnvironmentVariable("EDGAR_IDENTITY", $env:EDGAR_IDENTITY, "User")
    Write-Host "[OK] EDGAR_IDENTITY 已持久化到用户环境变量"
} else {
    Write-Host "[!] EDGAR_IDENTITY 未设置，美股 SEC 路由不可用"
}
if ($env:DART_API_KEY) {
    [Environment]::SetEnvironmentVariable("DART_API_KEY", $env:DART_API_KEY, "User")
    Write-Host "[OK] DART_API_KEY 已持久化到用户环境变量"
}
if ($env:EDINET_API_KEY) {
    [Environment]::SetEnvironmentVariable("EDINET_API_KEY", $env:EDINET_API_KEY, "User")
    Write-Host "[OK] EDINET_API_KEY 已持久化到用户环境变量"
}
[Environment]::SetEnvironmentVariable("EDGAR_LOCAL_DATA_DIR", $edgarDir, "User")
Write-Host "[OK] Edgar 数据目录: $edgarDir"

Write-Host "环境配置完成。Windows 可运行 powershell -NoProfile -ExecutionPolicy Bypass -File _scripts/bootstrap-ingest-deps.ps1 -CheckOnly；macOS 请运行 pwsh -NoProfile -ExecutionPolicy Bypass -File _scripts/bootstrap-ingest-deps.ps1 -CheckOnly。"
