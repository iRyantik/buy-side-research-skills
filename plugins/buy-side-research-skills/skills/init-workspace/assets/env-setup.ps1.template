# Workspace 环境配置入口
# 复制本文件为 env-setup.ps1，填入你的信息后运行：
#   Windows:  .\env-setup.ps1
#   macOS:    pwsh ./env-setup.ps1
#
# 这个模板是 workspace 级统一入口：
# - 先回答“整体有哪些环境要先知道”
# - 不替代 skill-local 文档
# - financial-data 仍是财务数据环境配置的详细 source of truth
# - ingest / reddit-sentiment 仍保留各自的 bootstrap 与 honest-fail 说明

# --- 平台 / 运行时基础 ---
# macOS 运行 workspace hooks 与 .ps1 helper 需要 PowerShell 7 (`pwsh`)

# --- Filing / financial-data 核心环境 ---
# 美股 SEC Filing（必填，否则 EdgarTools 不可用）
# 格式: "Name email@domain.com"
$env:EDGAR_IDENTITY = ""

# --- 韩国 DART API Key（financial-data 可选，拉取韩国上市公司财报需要）---
# 免费注册获取: https://opendart.fss.or.kr/
# $env:DART_API_KEY = ""

# --- 日本 EDINET API Key（financial-data 可选，拉取日本上市公司财报需要）---
# 免费注册 / 申请: https://disclosure2.edinet-fsa.go.jp/
# $env:EDINET_API_KEY = ""

# --- 台湾 FinMind token（optional；公开接口已可用，token 只在你需要更稳定配额时配置）---
# $env:FINMIND_TOKEN = ""

# --- EdgarTools 数据目录（避免 edgar/ 文件夹散落在当前目录）---
$edgarDir = Join-Path $PSScriptRoot "edgar_data"
New-Item -ItemType Directory -Force -Path $edgarDir | Out-Null
$env:EDGAR_LOCAL_DATA_DIR = $edgarDir

# --- 可选网络 / 镜像 ---
# 中国用户 HuggingFace 镜像（可选）---
# $env:HF_ENDPOINT = "https://hf-mirror.com"

# --- 可选 ingest / figure-description 环境 ---
# describe-figures 视觉模型（可选，Claude 多模态已覆盖）---
# $env:VLM_API_URL = "https://api.openai.com/v1"
# $env:VLM_API_KEY = ""
# $env:VLM_MODEL = "gpt-4o"

# --- 写入用户环境变量（持久化）---
# 只持久化最常见的共享环境项；更细的 skill-local 依赖和 fail 行为请继续看各自 SKILL.md
if ($env:EDGAR_IDENTITY) {
    [Environment]::SetEnvironmentVariable("EDGAR_IDENTITY", $env:EDGAR_IDENTITY, "User")
    Write-Host "[OK] EDGAR_IDENTITY 已持久化到用户环境变量"
} else {
    Write-Host "[!] EDGAR_IDENTITY 未设置，美股 SEC 路由不可用"
}
if ($env:DART_API_KEY) {
    [Environment]::SetEnvironmentVariable("DART_API_KEY", $env:DART_API_KEY, "User")
    Write-Host "[OK] DART_API_KEY 已持久化到用户环境变量"
}
if ($env:EDINET_API_KEY) {
    [Environment]::SetEnvironmentVariable("EDINET_API_KEY", $env:EDINET_API_KEY, "User")
    Write-Host "[OK] EDINET_API_KEY 已持久化到用户环境变量"
}
if ($env:FINMIND_TOKEN) {
    [Environment]::SetEnvironmentVariable("FINMIND_TOKEN", $env:FINMIND_TOKEN, "User")
    Write-Host "[OK] FINMIND_TOKEN 已持久化到用户环境变量"
}
[Environment]::SetEnvironmentVariable("EDGAR_LOCAL_DATA_DIR", $edgarDir, "User")
Write-Host "[OK] Edgar 数据目录: $edgarDir"

Write-Host "环境配置完成。下一步建议先做 check-only："
Write-Host "  financial-data:"
Write-Host "    Windows: powershell -NoProfile -ExecutionPolicy Bypass -File _scripts/financial-data/bootstrap-financial-data-deps.ps1 -CheckOnly"
Write-Host "    macOS:   pwsh -NoProfile -ExecutionPolicy Bypass -File _scripts/financial-data/bootstrap-financial-data-deps.ps1 -CheckOnly"
Write-Host "  ingest:"
Write-Host "    Windows: powershell -NoProfile -ExecutionPolicy Bypass -File _scripts/bootstrap-ingest-deps.ps1 -CheckOnly"
Write-Host "    macOS:   pwsh -NoProfile -ExecutionPolicy Bypass -File _scripts/bootstrap-ingest-deps.ps1 -CheckOnly"
Write-Host "             或 _scripts/bootstrap-ingest-deps.sh --check-only"
Write-Host "  reddit-sentiment:"
Write-Host "    这是额外可选 skill；bootstrap 命令请查看 reddit-sentiment 的 SKILL.md。"
