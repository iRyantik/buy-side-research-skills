{
  "id": "decision-journal",
  "name": "Decision Journal",
  "version": "2.0.0",
  "description": "Append-only 投资决策日志，使用 decision_v1 YAML blocks 写入 journal/decisions.md",
  "category": "research",
  "author": "buy-side-research-system",
  "tags": ["decision-journal", "portfolio", "calibration", "pnl-attribution"],
  "trigger": {
    "type": "keyword",
    "keywords": ["记录这个 decision", "建仓", "加仓", "减仓", "平仓", "写进 journal", "复盘这个动作"],
    "description": "当用户要记录投资动作或复盘决策时触发"
  },
  "capabilities": {
    "writes": "journal/decisions.md",
    "entry_schema": "decision_v1",
    "append_only": true,
    "requirements": ["follow CLAUDE.md source policy", "price/valuation/position/conviction required"]
  },
  "workflow": {
    "stage": "state",
    "consumes": ["coverage/[ticker]/thesis.md"],
    "feeds_into": ["thesis-tracker"]
  }
}
